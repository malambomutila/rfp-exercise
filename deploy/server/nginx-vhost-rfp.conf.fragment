    # ── RFP opportunities report (rfp.malambomutila.com) ────────────────────
    # Static report generated by the rfp-exercise repository and deployed to
    # /home/mm/apps/rfp/site by GitHub Actions over rsync. The content is
    # served by a separate container, rfp_site, defined in
    # /home/mm/apps/rfp/docker-compose.yml. This nginx only terminates TLS and
    # proxies, because it is the only container permitted to bind 80 and 443.
    #
    # Certificate: its own single-domain certificate at
    # /etc/nginx/ssl/live/rfp.malambomutila.com/, deliberately separate from
    # the shared ohasp certificate so that renewing one cannot affect the other.

    # HTTP: ACME challenge, then redirect everything else to HTTPS.
    server {
        listen 80;
        server_name rfp.malambomutila.com;

        # Shared Let's Encrypt webroot, same mechanism as the other subdomains.
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # HTTPS: terminate TLS and proxy to the static file container.
    server {
        listen 443 ssl;
        http2 on;
        server_name rfp.malambomutila.com;

        ssl_certificate     /etc/nginx/ssl/live/rfp.malambomutila.com/fullchain.pem;
        ssl_certificate_key /etc/nginx/ssl/live/rfp.malambomutila.com/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         HIGH:!aNULL:!MD5;
        ssl_session_cache   shared:SSL:10m;
        ssl_session_timeout 10m;

        # Resolve the upstream container name at request time via the Docker
        # embedded DNS resolver. Assigning proxy_pass from a variable means a
        # recreated rfp_site container with a new IP address is picked up
        # without an nginx reload, and a stopped rfp_site does not make
        # "nginx -t" fail for the whole server.
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $rfp_upstream "rfp_site:80";

        location / {
            proxy_pass       http://$rfp_upstream;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 60s;
        }
    }
}
