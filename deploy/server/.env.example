# Configuration for the RFP report stack.
#
# Copy to .env beside docker-compose.yml and fill in real values. That file
# stays on the server and is never committed: this repository is public, so
# anything written here would be readable by anyone.
#
#   cp .env.example .env && chmod 600 .env

# --- Login gate -------------------------------------------------------------

# Shared username and password for whoever should be able to read the report.
RFP_USER=[RFP_USER]
RFP_PASSWORD=[RFP_PASSWORD]

# Signing key for the session cookie. Generate a fresh one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If this is left unset the service generates an ephemeral key at startup, so
# everyone is signed out whenever the container restarts.
RFP_SESSION_SECRET=[RFP_SESSION_SECRET]

# How long a session lasts before the reader must sign in again.
RFP_SESSION_HOURS=12

# --- Scheduled build --------------------------------------------------------

# Time of day to rebuild the report, as UTC "HH:MM". The default of 05:30 UTC
# is 07:30 in Lusaka and 08:30 in Nairobi, so the report is ready before the
# working day. Pick a time roughly two hours before your own working day.
RFP_SCHEDULE_UTC=05:30

# How many days of notices to include. The report states this window on the
# page, so changing it changes what the page claims.
RFP_WINDOW_DAYS=7

# Build once immediately when the container starts, rather than leaving the
# site empty until the next scheduled time. Set to 0 to wait for the schedule.
RFP_RUN_ON_START=1

# --- Scoring ----------------------------------------------------------------

# Optional. With a key, the top 25 results are re-scored by the model, which
# also writes the plain-English rationale under each opportunity. Without one
# the report still builds, using the deterministic keyword layer alone.
# An OpenRouter key works, as does anything exposing the same chat completions
# API at that address.
OPENROUTER_API_KEY=[OPENROUTER_API_KEY]

# --- Networking -------------------------------------------------------------

# The existing Docker network your reverse proxy is on, so it can reach the
# rfp_site container by name. Create one if you have none:
#   docker network create rfp_network
RFP_NETWORK=rfp_network
