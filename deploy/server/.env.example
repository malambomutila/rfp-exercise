# Login gate credentials for the RFP report.
#
# Copy to /home/mm/apps/rfp/.env on the server and fill in real values. That
# file stays on the server and is never committed: this repository is public,
# so anything written here would be readable by anyone.
#
#   chmod 600 /home/mm/apps/rfp/.env

# Shared username and password for IDinsight reviewers.
RFP_USER=[RFP_USER]
RFP_PASSWORD=[RFP_PASSWORD]

# Signing key for the session cookie. Generate a fresh one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If this is left unset the service generates an ephemeral key at startup, so
# everyone is signed out whenever the container restarts.
RFP_SESSION_SECRET=[RFP_SESSION_SECRET]

# How long a session lasts before the visitor must sign in again.
RFP_SESSION_HOURS=12
