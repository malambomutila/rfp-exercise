# Personal scratch space, never tracked
local/

# Credentials
.env
*.env
!*.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/

# Cached API responses
data/raw/

# The dated report archive now lives on the server, in
# deploy/server/reports, written by the scheduler container. It is generated
# output and no longer belongs in the repository.
reports/
deploy/server/site/
deploy/server/reports/
deploy/server/cache/

# Agent tooling scratch output
.playwright-mcp/
# Generated report output. Rebuilt by every run and by the Actions job,
# so it must never be committed. site2/ and the rest cover the scratch
# build directories produced by --out when comparing two scoring runs.
site/
site2/
site_*/
